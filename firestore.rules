rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is authenticated and matches the requested userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Checks if the user is an admin or super admin.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // Helper: Checks if userId belongs to a guest user (starts with 'guest_')
    function isGuestChat(userId) {
      return userId is string && userId.matches('^guest_.*');
    }

    // Support Chats collection
    match /supportChats/{chatId} {
      
      // Allow read/list if user is owner, admin, or guest chat
      allow read: if (request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid)) ||
                     isGuestChat(resource.data.userId);
      
      // Allow create if user is owner, admin, or guest chat
      allow create: if (request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid)) ||
                      isGuestChat(request.resource.data.userId);
      
      // Allow update if owner, admin, or guest chat
      allow update: if (request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid)) ||
                       isGuestChat(resource.data.userId);
      
      // Only admins or authenticated room owners can delete support chat rooms (guests cannot delete rooms)
      allow delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      
      // Messages subcollection
      match /messages/{messageId} {
        
        // Allow read/list and create if owner of parent chat, admin, or guest parent chat
        allow read, create: if (request.auth != null && (isAdmin() || get(/databases/$(database)/documents/supportChats/$(chatId)).data.userId == request.auth.uid)) ||
                               isGuestChat(get(/databases/$(database)/documents/supportChats/$(chatId)).data.userId);
        
        // Allow update (such as marking read = true) if admin, owner, or guest parent chat
        allow update: if (request.auth != null && (isAdmin() || get(/databases/$(database)/documents/supportChats/$(chatId)).data.userId == request.auth.uid)) ||
                         isGuestChat(get(/databases/$(database)/documents/supportChats/$(chatId)).data.userId);

        // Only allow admins to delete individual chat messages
        allow delete: if request.auth != null && isAdmin();
      }
    }

    // Archived Chat Users collection (Admins and owners for auto-unarchive)
    match /archivedChatUsers/{userId} {
      allow read, write: if (request.auth != null && (isAdmin() || request.auth.uid == userId)) ||
                            isGuestChat(userId);
    }
    
    // Live Auctions collection (Public read for real-time live room telemetry)
    match /liveAuctions/{auctionId} {
      allow read: if true;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if (request.auth != null && isAdmin()) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']);
    }

    // Default deny rule for any other collection/document
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
